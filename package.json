{
  "name": "fresh",
  "type": "module",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fresh --local",
    "db:migrate:prod": "wrangler d1 migrations apply fresh --remote",
    "cf:typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.3",
    "@lucide/svelte": "^1.43.0",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "svelte": "^5.57.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^1.1.1"
    },
    "better-auth": {
      "vitest": "$vitest"
    },
    "miniflare": {
      "sharp": "0.35.4"
    },
    "esbuild": "0.28.2"
  }
}
