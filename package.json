{
  "name": "fresh",
  "type": "module",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fresh --local",
    "db:migrate:prod": "wrangler d1 migrations apply fresh --remote",
    "cf:typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.23",
    "@lucide/svelte": "^1.25.0",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.0",
    "markdown-it": "^14.3.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "svelte": "^5.56.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "cookie": "0.7.2",
    "esbuild": "0.28.1"
  }
}
